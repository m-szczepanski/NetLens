# Frontend -> backend connection settings (all PUBLIC_* vars are embedded in the client bundle).
# Leave empty for same-origin (production: UI served by the NetLens binary itself).
# For `npm run dev` against a local Go backend, set e.g.:
#   PUBLIC_BACKEND_HTTP_URL=http://localhost:8080
PUBLIC_BACKEND_HTTP_URL=
PUBLIC_BACKEND_WS_URL=
